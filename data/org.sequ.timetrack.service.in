[D-BUS Service]
Name=org.sequ.timetrack
# D-Bus launches Exec directly -- it is NOT run through a shell, so this must
# be a real executable path, not `sh -c ...`.
#
# For host installs: the GUI from a host build cannot start the service
# itself, so activation must resolve to an installed binary.
# /usr/bin first (package install), then the user's own bin.
# (The AppImage needs none of this: it bundles the service and starts it
# in the background when the app launches.)
Exec=/usr/bin/timetrack-service
